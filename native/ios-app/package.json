{
  "name": "lightcraft-native-ios",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "bundle": "esbuild src/native-entry.mjs --bundle --format=esm --platform=browser --target=es2022 --outfile=../../target/web-site/native-storage.js",
    "sync:ios": "npm run bundle && npx cap sync ios && node scripts/configure-ios.mjs",
    "test": "node --test ../../tests/native-storage.test.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/filesystem": "^8.1.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "esbuild": "^0.25.0"
  }
}
